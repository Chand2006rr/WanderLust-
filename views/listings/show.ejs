<% layout("/layouts/boilerplate.ejs") %>
<div class="row">
    <div class="mb-3 mt-3 col-6 offset-3 listing-card">
        <div class="card">
                <h3><%= listing.title%></h3>
                <img src="<%= listing.image?.url || 'https://via.placeholder.com/400x250?text=No+Image' %>"
                    class="card-img-top show-img">
                <div class="card-body">
                    <p class="card-text">
                            <%= listing.description%><br>
                                <%= listing.image %><br>
                                    &#8377;<%= listing.price.toLocaleString("en-IN")%><br>
                                        <%= listing.country%><br>
                                            <%= listing.location%>
                    </p>
                </div>
            </div>
            <div class="btns">
                <a href="/listings/<%= listing._id%>/edit" class="btn btn-dark col-1 edit-btn">Edit</a>
                <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
                    <button class="btn btn-dark offset-5">Delete</button>
                </form>
                <br>
            </div>
            <br>

            <div class="col-12 mb-3 mt-3">
                <hr>
                <h4>Leave a Review</h4>
                <form method="POST" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">
                    <div class="mb-3 mt-3">
                        <label for="rating" class="form-label">Rating</label>
                        <input type="range" min="1" max="5" name="review[rating]" id="rating">
                    </div>
                    <div class="mb-3 mt-3">
                        <label for="comment" class="form-label">Comment</label>
                        <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
                        <div class="invalid-feedback">Please submit your comment for review</div>
                    </div>
                    <button class="btn btn-dark">Submit</button>
                </form>

                <P><b>All Reviews</b></P>
                <div class="row">
                    <% for(let review of listing.reviews) { %>
                    <div class="card col-6 mb-3 mt-3">
                        <div class="card-body">
                            <h5 class="card-title">Jane Doe</h5>
                            <p class="card-text"><%= review.comment %> </p>
                            <p class="card-text"><%= review.rating %>stars</p>
                            <form class="mb-3" method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                            <button class="btn btn-dark">Delete</button>
                            </form>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>